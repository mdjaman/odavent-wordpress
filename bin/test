#!/usr/bin/env sh
# Runs PHPUnit 9.6 inside Docker on a real PHP (default 7.4, the plugin's floor).
# Usage: bin/test [phpunit arguments]
#        PHP_VERSION=8.3 bin/test      # another PHP version
set -e
cd "$(dirname "$0")/.."

PHP_VERSION="${PHP_VERSION:-7.4}"
IMAGE="odavent-events-test:${PHP_VERSION}"

# docker build is layer-cached, so this is cheap when nothing changed.
docker build --quiet --build-arg "PHP_VERSION=${PHP_VERSION}" -t "$IMAGE" -f docker/Dockerfile.test docker >/dev/null

exec docker run --rm -v "$PWD":/app -w /app "$IMAGE" sh -c \
  'composer install --no-interaction --prefer-dist --no-progress --quiet && vendor/bin/phpunit "$@"' sh "$@"
